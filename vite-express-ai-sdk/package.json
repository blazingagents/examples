{
  "name": "@blazing-agents/example-vite-express-ai-sdk",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "npm run typecheck && npm run lint",
    "dev": "node --experimental-strip-types server.ts",
    "fix": "ultracite fix src server server.ts",
    "lint": "ultracite check src server server.ts",
    "start": "NODE_ENV=production node --experimental-strip-types server.ts",
    "start:test": "NODE_ENV=test node --experimental-strip-types server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.87",
    "@blazingagents/sdk": "0.1.0",
    "ai": "7.0.84",
    "express": "5.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "typescript": "7.0.2",
    "ultracite": "7.10.2",
    "vite": "8.2.2"
  }
}
