{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blazing-agents-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["enable_request_signal"],
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173",
    "BLAZING_AGENTS_BASE_URL": "https://api.blazingagents.com",
    "BLAZING_AGENTS_MODEL": "replace-with-a-model-your-provider-serves",
    "BLAZING_AGENTS_PROVIDER_ID": "prv_replace_me"
  }
}
