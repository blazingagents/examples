{
  "name": "@blazing-agents/example-cloudflare-worker-relay",
  "private": true,
  "scripts": {
    "check": "npm run typecheck && npm run lint",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "fix": "ultracite fix src",
    "lint": "ultracite check src",
    "start:test": "wrangler dev --ip 127.0.0.1 --port ${PORT:-8787} --var ALLOWED_ORIGINS:$ALLOWED_ORIGINS --var APP_USER_A_TOKEN:$APP_USER_A_TOKEN --var APP_USER_B_TOKEN:$APP_USER_B_TOKEN --var BLAZING_AGENTS_API_KEY:$BLAZING_AGENTS_API_KEY --var BLAZING_AGENTS_BASE_URL:$BLAZING_AGENTS_BASE_URL --var BLAZING_AGENTS_MODEL:$BLAZING_AGENTS_MODEL --var BLAZING_AGENTS_PROVIDER_ID:$BLAZING_AGENTS_PROVIDER_ID",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@blazingagents/sdk": "0.46.0",
    "ai": "7.0.84"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260831.1",
    "typescript": "7.0.2",
    "ultracite": "7.10.2",
    "wrangler": "4.143.0"
  }
}
